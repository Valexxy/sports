# ==============================================================================
# AURASCORE / MIVAJ PRODUCTION ENVIRONMENT CONFIGURATION (mivaj.com)
# ==============================================================================

# Core Platform Settings
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://mivaj.com
SESSION_SECRET=aurascore_enterprise_secret_key_2026_super_secure_sha256

# Database & Supabase (Use PgBouncer Transaction Pooler for Port 6543)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9... # NEVER EXPOSE TO CLIENT!
DATABASE_URL=postgres://postgres.your-ref:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Paystack Payments (Nigeria Direct Bank Settlements & Cards)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_c3ac464a91290f7507e5e36f5b0bec3ac0da9f5a
PAYSTACK_SECRET_KEY=sk_live_your_secret_key_here
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_signature

# Monetag & Advertising
NEXT_PUBLIC_MONETAG_ZONE_ID=11643531

# Web Push Notifications (VAPID Keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BExamplePublicKeyHere...
VAPID_PRIVATE_KEY=ExamplePrivateKeyHere...
VAPID_SUBJECT=mailto:support@mivaj.com

# Redis / Upstash Cache (Optional for Edge Caching)
