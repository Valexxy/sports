# AURASCORE STADIUM 2.0 - ENVIRONMENT CONFIGURATION TEMPLATE

# 1. Geolocation & Location Tracking
NEXT_PUBLIC_GEOAPIFY_API_KEY=your_geoapify_key_here

# 2. Live Fiat Currency Exchange Rates
EXCHANGE_RATE_API_KEY=your_exchangerate_api_key_here

# 3. Live Football Scores & Standings
FOOTBALL_DATA_TOKEN=your_football_data_token_here

# 4. Bookmaker Odds & Betting Markets
THE_ODDS_API_KEY=your_odds_api_key_here

# 5. API-Sports / RapidAPI Football Feeds
API_FOOTBALL_KEY=your_api_football_key_here

# 6. Breaking Multi-Sport News Feeds
NEWSDATA_API_KEY=your_newsdata_key_here
MEDIASTACK_API_KEY=your_mediastack_key_here

# 7. AI Engines (Groq, Gemini, OpenAI, HuggingFace)
GROQ_API_KEY=your_groq_key_here
GEMINI_API_KEY=your_gemini_key_here
HF_TOKEN=your_huggingface_token_here
OPENAI_API_KEY=your_openai_key_here

# 8. Upstash QStash & Distributed Redis
QSTASH_URL=https://qstash-us-east-1.upstash.io
QSTASH_TOKEN=your_qstash_token_here
QSTASH_CURRENT_SIGNING_KEY=your_qstash_signing_key_here
UPSTASH_REDIS_REST_URL=your_upstash_redis_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# 9. Apify & Pusher WebSockets
APIFY_API_TOKEN=your_apify_token_here
NEXT_PUBLIC_PUSHER_KEY=your_pusher_key_here

# 10. Supabase PostgreSQL & Realtime Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ACCESS_TOKEN=your_supabase_personal_access_token_here

# 11. Site Origin
NEXT_PUBLIC_SITE_URL=http://localhost:3000
