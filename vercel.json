{
  "crons": [
    {
      "path": "/api/cron/telegram-morning",
      "schedule": "0 4,5,6 * * *"
    },
    {
      "path": "/api/cron/telegram-news",
      "schedule": "0 11,17 * * *"
    },
    {
      "path": "/api/cron/telegram-live-settle",
      "schedule": "*/30 14-23 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
