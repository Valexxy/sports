{
  "crons": [
    {
      "path": "/api/cron/telegram-morning",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/facebook-autopost",
      "schedule": "0 */2 * * *"
    },
    {
      "path": "/api/cron/telegram-live-settle",
      "schedule": "*/30 14-23 * * *"
    },
    {
      "path": "/api/cron/telegram-settle",
      "schedule": "30 21 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
